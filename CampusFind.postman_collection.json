{
  "info": {
    "name": "CampusFind",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom on a fresh database. adminId=1, staffId=2, studentId=3."
  },
  "item": [
    {
      "name": "1. Main flow",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campus.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register a new student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Kumar\",\n  \"email\": \"asha@campus.com\",\n  \"password\": \"secret123\",\n  \"role\": \"STUDENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "Add category (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Umbrella\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Student reports a lost calculator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lost"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 4,\n  \"description\": \"Black Casio calculator with blue sticker\",\n  \"location\": \"Library second floor\",\n  \"dateLost\": \"2026-09-25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Staff logs a found calculator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 4,\n  \"description\": \"Casio calculator black, sticker on the back\",\n  \"location\": \"Library reading room\",\n  \"dateFound\": \"2026-09-26\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List possible matches (student)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          }
        },
        {
          "name": "List lost reports filtered by category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lost?categoryId=4&status=OPEN",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lost"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "4"
                },
                {
                  "key": "status",
                  "value": "OPEN"
                }
              ]
            }
          }
        },
        {
          "name": "Staff confirms the match",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/matches/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lostReportId\": 1,\n  \"foundItemId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Business rule checks",
      "item": [
        {
          "name": "RULE 1 violated: RETURNED before CLAIMED -> 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RETURNED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "RULE 2 violated: student changes status -> 403",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLAIMED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Validation: empty description -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lost"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 4,\n  \"description\": \"\",\n  \"location\": \"Canteen\",\n  \"dateLost\": \"2026-09-25\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Validation: future date -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lost"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 4,\n  \"description\": \"Blue bottle\",\n  \"location\": \"Canteen\",\n  \"dateLost\": \"2999-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Not found: unknown found item -> 404",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/999/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "999",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLAIMED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "No login header -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "lost"
              ]
            }
          }
        },
        {
          "name": "Student cannot log found item -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{studentId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 4,\n  \"description\": \"Some item\",\n  \"location\": \"Gate\",\n  \"dateFound\": \"2026-09-26\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Bad enum value -> 400",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"LOST\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Claim, return, dashboard",
      "item": [
        {
          "name": "Staff marks item CLAIMED -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLAIMED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Staff marks item RETURNED -> 200",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found/1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found",
                "1",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RETURNED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Found items list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{staffId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/found",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "found"
              ]
            }
          }
        },
        {
          "name": "Admin dashboard counts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            }
          }
        },
        {
          "name": "Admin lists users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{adminId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "users"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminId",
      "value": "1"
    },
    {
      "key": "staffId",
      "value": "2"
    },
    {
      "key": "studentId",
      "value": "3"
    }
  ]
}